{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sixscripts.ai/schemas/skillcheck-report-v1.json",
  "title": "SkillCheck Report v1",
  "type": "object",
  "required": ["schemaVersion", "scannerVersion", "policyVersion", "policyFingerprint", "fingerprint", "generatedAt", "score", "status", "declaredPermissions", "inferredPermissions", "findings", "packageRisks", "remediation", "gate"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "scannerVersion": { "type": "string" },
    "policyVersion": { "type": "string" },
    "policyFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "status": { "enum": ["pass", "review", "block"] },
    "declaredPermissions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "inferredPermissions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "packageRisks": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "remediation": { "type": "array", "items": { "type": "string" } },
    "gate": { "type": "object", "required": ["publishable", "reasons"], "properties": { "publishable": { "type": "boolean" }, "reasons": { "type": "array", "items": { "type": "string" } } } }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["id", "severity", "title", "remediation", "occurrences"],
      "properties": {
        "id": { "type": "string" },
        "severity": { "enum": ["info", "warning", "error"] },
        "permission": { "type": ["string", "null"] },
        "title": { "type": "string" },
        "remediation": { "type": "string" },
        "occurrences": { "type": "array", "items": { "type": "object", "required": ["file", "line", "evidence"], "properties": { "file": { "type": "string" }, "line": { "type": "integer", "minimum": 1 }, "evidence": { "type": "string" } } } }
      }
    }
  }
}

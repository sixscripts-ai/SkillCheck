      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@sixscripts/skillcheck-sdk": {
      "resolved": "packages/sdk",
      "link": true
    },
    "packages/cli": {
      "name": "@sixscripts/skillcheck-cli",
      "version": "1.0.0-rc.1",
      "license": "MIT",
      "dependencies": {
        "@sixscripts/skillcheck-sdk": "1.0.0-rc.1"
      },
      "bin": {
        "skillcheck": "src/index.js"
      },
      "engines": {
        "node": ">=20"
      }
    },
    "packages/core": {
      "name": "@sixscripts/skillcheck-core",
      "version": "1.0.0-rc.1",
      "license": "MIT"
    },
    "packages/sdk": {
      "name": "@sixscripts/skillcheck-sdk",
      "version": "1.0.0-rc.1",
      "license": "MIT",
      "dependencies": {
        "@sixscripts/skillcheck-core": "1.0.0-rc.1"
      }
    }
  }
}

{
  "name": "@sixscripts/skillcheck",
  "version": "1.0.0-rc.1",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "@sixscripts/skillcheck",
      "version": "1.0.0-rc.1",
      "license": "MIT",
      "workspaces": [
        "packages/*"
      ],
      "bin": {
        "skillcheck": "packages/cli/src/index.js"
      },
      "engines": {
        "node": ">=20"
      }

{
  "name": "@sixscripts/skillcheck",
  "version": "1.0.0-rc.1",
  "description": "Deterministic SDK, CLI, GitHub Action, and browser scanner for AI agent skill packages",
  "type": "module",
  "private": false,
  "workspaces": ["packages/*"],
  "exports": {
    ".": "./packages/sdk/src/index.js",
    "./core": "./packages/core/src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "skillcheck": "./packages/cli/src/index.js"
  },
  "files": [
    "packages/core/src",
    "packages/sdk/src",
    "packages/cli/src",
    "action.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build:web": "node scripts/build-web.mjs",
    "check": "npm test && npm run build:web && node packages/cli/src/index.js scan --root fixtures/safe --quiet && node tests/assert-unsafe-blocked.mjs",
    "prepack": "npm run check"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}

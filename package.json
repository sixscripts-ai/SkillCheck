{
  "name": "@sixscripts-ai/skillcheck",
  "version": "1.0.0-rc.1",
  "description": "Deterministic SDK, CLI, GitHub Action, and browser scanner for AI agent skill packages",
  "type": "module",
  "private": false,
  "workspaces": [
    "packages/*"
  ],
  "exports": {
    ".": {
      "types": "./packages/sdk/src/index.d.ts",
      "import": "./packages/sdk/src/index.js"
    },
    "./core": {
      "types": "./packages/core/src/index.d.ts",
      "import": "./packages/core/src/index.js"
    },
    "./zip": {
      "types": "./packages/sdk/src/index.d.ts",
      "import": "./packages/sdk/src/zip.js"
    },
    "./schemas/report": "./schemas/report.schema.json",
    "./schemas/evidence": "./schemas/evidence.schema.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "skillcheck": "packages/cli/src/index.js"
  },
  "files": [
    "packages/core/src",
    "packages/sdk/src",
    "packages/cli/src",
    "action.yml",
    "README.md",
    "LICENSE",
    "packages/sdk/src/index.d.ts",
    "packages/core/src/index.d.ts",
    "schemas"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build:web": "node scripts/build-web.mjs",
    "check": "npm test && npm run build:web && node packages/cli/src/index.js scan --root fixtures/safe --quiet && node tests/assert-unsafe-blocked.mjs",
    "test:package": "node scripts/verify-package-install.mjs",
    "release:verify": "npm run check && npm run test:package",
    "prepack": "npm run release:verify"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
